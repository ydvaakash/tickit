# This file is part of Tickit, owned and operated by Aakash Yadav.
# It defines files and directories that should be ignored by Git.

# Node.js dependencies
node_modules/

# TypeScript build output
dist/
dist-ssr
*.local

# Environment variables
.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# Editor & OS-specific files
.vscode/                # VSCode workspace settings (optional, remove if you want to share workspace settings)
.vscode/**.cache        # Cache files inside .vscode folder
.vscode-test/           # VSCode test workspaces
.idea/                  # WebStorm/IntelliJ IDE settings (just in case)
.DS_Store               # macOS system file
Thumbs.db               # Windows system file
!.vscode/extensions.json

# Docker-related files
docker-compose.override.yml
docker-compose.override.yaml
.dockerignore
**/docker-data/
**/docker-volumes/

# PostgreSQL-related files (if applicable)
*.pgsql
*.psql
pgdata/
postgres-data/
dump.sql

# Build artifacts
*.out
*.o
*.obj
*.exe
*.a
*.so
*.dylib
*.dll

# Other potential ignored files
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.asc
.asc

# Frontend build output (Vite)
frontend/dist/
frontend/.vite/
.vite/

# Frontend environment files
frontend/.env
frontend/.env.*      # Like .env.local, .env.production etc.

# Frontend editor/browser tooling
frontend/.eslintcache
frontend/.parcel-cache
frontend/.turbo/     # If you use Turborepo in future

# Backend compiled output (TypeScript)
backend/build/
backend/lib/          # Some setups use lib/ instead of build/dist

# Backend environment files
backend/.env
backend/.env.*        # .env.local, .env.production, etc.

# TypeScript TSBuildInfo (from incremental builds)
**/tsconfig.tsbuildinfo

# React testing related
frontend/coverage/
frontend/jest.config.js
frontend/jest.setup.js

# Storybook
frontend/storybook-static/
frontend/.storybook/

# Misc
*.tgz                 # Tarballs when packing npm packages
.nyc_output/          # Code coverage output from tools like nyc
coverage/
