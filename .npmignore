# This file is part of Tickit, owned and operated by Aakash Yadav.
# It defines files and directories that should be excluded from the npm package.


# Allow .env.example to be included in the npm package
!.env.example

# Exclude TypeScript source files
src/

# Exclude environment variables
.env
.env.local
.env.*.local

# Exclude build tools & configs
node_modules/
tsconfig.json
tsconfig.*.json
jest.config.js
.eslintrc.js
.prettierrc
.prettierignore

# Exclude logs and cache files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Exclude Docker and PostgreSQL related files
docker-compose.override.yml
docker-compose.override.yaml
.dockerignore
**/docker-data/
**/docker-volumes/
pgdata/
postgres-data/
dump.sql

# Exclude editor and OS-specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Exclude test files and coverage reports
__tests__/
__mocks__/
coverage/
*.test.ts
*.spec.ts
.jest/
.jest-cache/
.jest-test-results.json

*.asc
.asc